# Backend API (Cloudflare Worker that proxies the Anthropic API)
VITE_API_URL=https://swingcheck-api.swing-check.workers.dev

# Optional: Supabase backend for cross-device swing history.
# When both are set, swing metadata + results sync to Supabase (IndexedDB stays as the
# local cache for video/frames). When unset, the app runs IndexedDB-only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
