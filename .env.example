# Backend API (Cloudflare Worker that proxies the Anthropic API)
# The Worker only answers origins listed in its ALLOWED_ORIGINS var, so whichever origin
# this app is served from must be on that list — see worker/wrangler.toml. The Worker's
# own settings (ALLOWED_ORIGINS, MODEL_ID, MAX_TOKENS, BODY_MAX_BYTES, DAILY_CALL_CAP)
# live there and in `wrangler secret`, never in this file.
VITE_API_URL=https://swingcheck-api.swing-check.workers.dev

# Optional: Supabase backend for cross-device swing history.
# When both are set, swing metadata + results sync to Supabase (IndexedDB stays as the
# local cache for video/frames). When unset, the app runs IndexedDB-only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
