{
  "expo": {
    "name": "SwingCheck",
    "slug": "swingcheck",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "owner": "erikhawerman",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/354490e7-bf0e-4dff-b111-c0f3d446a335"
    },
    "ios": {
      "bundleIdentifier": "se.swingcheck.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "SwingCheck filmar din sving för att analysera den.",
        "NSPhotoLibraryUsageDescription": "SwingCheck öppnar klipp från din kamerarulle så att du kan analysera svingen.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "se.swingcheck.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-dev-client",
      "expo-sharing",
      "expo-asset",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "SwingCheck öppnar klipp från din kamerarulle så att du kan analysera svingen.",
          "cameraPermission": "SwingCheck filmar din sving för att analysera den.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "354490e7-bf0e-4dff-b111-c0f3d446a335"
      }
    }
  }
}
