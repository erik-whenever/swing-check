{
  "expo": {
    "name": "SwingCheck",
    "slug": "swingcheck",
    "version": "0.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "owner": "erikhawerman",
    "ios": {
      "bundleIdentifier": "se.swingcheck.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "SwingCheck filmar din sving för att analysera den.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "se.swingcheck.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-dev-client",
      "expo-sharing",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "354490e7-bf0e-4dff-b111-c0f3d446a335"
      }
    }
  }
}
