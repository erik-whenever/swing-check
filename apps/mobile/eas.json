{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "resourceClass": "default" },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://swingcheck-api.swing-check.workers.dev/api/analyze"
      },
      "ios": { "resourceClass": "default" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://swingcheck-api.swing-check.workers.dev/api/analyze"
      },
      "ios": { "resourceClass": "default" }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
