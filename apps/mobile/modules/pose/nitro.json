{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "swingcheck",
    "pose"
  ],
  "ios": {
    "iosModuleName": "SwingPose"
  },
  "android": {
    "androidNamespace": [
      "swingcheck",
      "pose"
    ],
    "androidCxxLibName": "SwingPose"
  },
  "autolinking": {
    "PoseDetector": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridPoseDetector"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridPoseDetector"
      }
    },
    "PoseProbe": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridPoseProbe"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
