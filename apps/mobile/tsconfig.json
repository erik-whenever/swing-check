{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // Tests: tsconfig.test.json (checked by the root's tsc -b, where vitest lives).
  "exclude": ["node_modules", "android", "ios", "modules/*/nitrogen", "**/*.test.ts"]
}
