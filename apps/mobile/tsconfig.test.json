{
  // The app's vitest tests (pure state models + persistence, N-3.6). They run from the repo
  // root's vitest and are type-checked by the root's `tsc -b` (referenced from
  // ../../tsconfig.json), because vitest is a root dependency, not one of the app's.
  // tsconfig.json leaves them out so the app's own `tsc --noEmit` never depends on the
  // root install. Tests may import only expo-free modules.
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.mobile-test.tsbuildinfo",
    "target": "es2023",
    // DOM: core's types reach for fetch/Blob/console, as in packages/core/tsconfig.json.
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": [],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    // strict like the app; core is compiled without it, so its catch variables stay `any`.
    "strict": true,
    "useUnknownInCatchVariables": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.test.ts"]
}
