{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "POSE_MODEL": "lite" },
      "ios": { "resourceClass": "default" },
      "android": { "buildType": "apk" }
    },
    "development-full": {
      "extends": "development",
      "env": { "POSE_MODEL": "full" }
    }
  }
}
