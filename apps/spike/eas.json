{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "resourceClass": "default" },
      "android": { "buildType": "apk" }
    },
    "pose-lite": {
      "extends": "development",
      "env": { "SPIKE": "pose", "POSE_MODEL": "lite" }
    },
    "pose-full": {
      "extends": "development",
      "env": { "SPIKE": "pose", "POSE_MODEL": "full" }
    },
    "shaft": {
      "extends": "development",
      "env": { "SPIKE": "shaft" }
    }
  }
}
