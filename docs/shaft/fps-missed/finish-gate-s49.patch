+/**
+ * Side weight `a` of the 3-tap kernel [a, 1−2a, a] that gives the finish gate's speed
+ * series, at sample interval `dt`, the same temporal smoothing `speedSm` has at
+ * FINISH_REF_DT. `speedSm` = moving average on position → first difference → moving
+ * average on speed; as a filter on velocity its time variance is
+ *   2 · h(h+1)/3 · dt²  +  dt²/12      (two (2h+1)-tap averages + the difference's box),
+ * h = SMOOTH_HALF, i.e. (17/12)·dt² for h = 1. The 3-tap kernel contributes 2a·dt² per
+ * pass, so a = (refVar/dt² − 1/12) / 4. Clamped to [0, 1/3]; 1/3 is today's average, and
+ * at ≥ 30 fps the caller uses `speedSm` itself. 15 fps → a = 13/192 ≈ 0.068.
+ * OSÄKER: the undersampling of a ~0.15 s downswing at 15 fps is not recoverable — this
+ * removes the smoothing's share of the peak shrink, not the sampling's.
+ */
+function finishKernelSide(dt: number): number {
+  const h = SMOOTH_HALF;
+  const refVar = ((2 * h * (h + 1)) / 3 + 1 / 12) * FINISH_REF_DT ** 2;
+  const a = (refVar / dt ** 2 - 1 / 12) / 4;
+  return Math.min(1 / 3, Math.max(0, a));
+}
+
+/** Speed series for the finish gate (S-49): `speedSm`'s chain with the time-matched
+ *  kernel from `finishKernelSide`. Returns `speedSm` unchanged at ≥ 30 fps. */
+function finishGateSpeed(filled: Vec[], t: number[], sampleDt: number, speedSm: number[]): number[] {
+  const a = finishKernelSide(sampleDt);
+  if (a >= 1 / 3) return speedSm;
+  const w = [a, 1 - 2 * a, a];
+  const p = smoothVecWeighted(filled, w);
+  const speed = new Array<number>(p.length).fill(0);
+  for (let i = 1; i < p.length; i++) {
+    const dt = t[i] - t[i - 1] || sampleDt;
+    speed[i] = dist(p[i], p[i - 1]) / dt;
+  }
+  return smoothWeighted(speed, w);
+}
+
+/** Centered 3-tap weighted average; weights renormalised over in-range taps at the
+ *  edges, as `smooth` does. */
+function smoothWeighted(v: number[], w: number[]): number[] {
+  const out = new Array<number>(v.length);
+  for (let i = 0; i < v.length; i++) {
+    let sum = 0;
+    let k = 0;
+    for (let j = -1; j <= 1; j++) {
+      if (i + j >= 0 && i + j < v.length) {
+        sum += v[i + j] * w[j + 1];
+        k += w[j + 1];
+      }
+    }
+    out[i] = sum / k;
+  }
+  return out;
+}
+
+function smoothVecWeighted(v: Vec[], w: number[]): Vec[] {
+  const xs = smoothWeighted(v.map((p) => p.x), w);
+  const ys = smoothWeighted(v.map((p) => p.y), w);
+  return xs.map((x, i) => ({ x, y: ys[i] }));
+}
